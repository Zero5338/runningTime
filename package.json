{
  "name": "runningtime",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n web,api -c blue,green \"npm run dev -w @runningtime/web\" \"npm run dev -w @runningtime/api\"",
    "dev:web": "npm run dev -w @runningtime/web",
    "dev:api": "npm run dev -w @runningtime/api",
    "build": "npm run build -w @runningtime/api && npm run build -w @runningtime/web",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "db:generate": "npm run db:generate -w @runningtime/api",
    "db:migrate": "npm run db:migrate -w @runningtime/api",
    "db:studio": "npm run db:studio -w @runningtime/api"
  },
  "devDependencies": {
    "concurrently": "10.0.6",
    "husky": "9.1.7",
    "lint-staged": "16.4.0",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "typescript": "5.9.3"
  }
}
